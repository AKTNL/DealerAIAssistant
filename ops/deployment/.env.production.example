APP_IMAGE=agentpoc
APP_VERSION=2026.08.16-1
APP_PUBLIC_PORT=8081

APP_DB_NAME=agentpoc
APP_DB_USERNAME=agentpoc
APP_DB_PASSWORD_FILE=./secrets/database-password

APP_CORS_ALLOWED_ORIGINS=https://dealer-ai.example.com
APP_EXCEL_FILE=../../backend/src/main/resources/Sample Data.xlsx

APP_MODEL_SECRET_KEY_FILE=./secrets/model-secret-key
APP_MODEL_ALLOWED_HOSTS=api.openai.com
APP_MODEL_ALLOW_PRIVATE_HOSTS=false
APP_NOTIFICATION_SECRET_KEY_FILE=./secrets/notification-secret-key
APP_NOTIFICATION_SMTP_ALLOWED_HOSTS=smtp.example.com

SPRING_AI_OPENAI_API_KEY_FILE=./secrets/embedding-api-key
SPRING_AI_OPENAI_EMBEDDING_OPTIONS_MODEL=text-embedding-ada-002

MANAGEMENT_OTLP_TRACING_EXPORT_ENABLED=false
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
MANAGEMENT_TRACING_SAMPLING_PROBABILITY=0.1

# Used only with compose.bootstrap.yml for the first empty-database startup.
APP_AUTH_BOOTSTRAP_USERNAME=initial.admin
APP_AUTH_BOOTSTRAP_DISPLAY_NAME=Initial Administrator
APP_AUTH_BOOTSTRAP_PASSWORD_FILE=./secrets/bootstrap-password
