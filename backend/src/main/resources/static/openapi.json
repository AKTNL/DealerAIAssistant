    "/api/reports/drafts": {
      "post": {
        "operationId": "createReportDraft",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/ReportDraftRequest" } }
          }
        },
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ReportDraftResponse" }
              }
            }
          },
          "400": { "description": "invalid report request" }
        }
      },
      "get": {
        "operationId": "listReportDrafts",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "success",
            "content": {
              "application/json": { "schema": { "$ref": "#/components/schemas/ReportDraftListResponse" } }
            }
          }
        }
      }
    },
    "/api/reports/drafts/{id}": {
      "get": {
        "operationId": "getReportDraft",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "success", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReportDraftResponse" } } } },
          "404": { "description": "report draft not found" }
        }
      }
    },
    "/api/reports/drafts/{id}/markdown": {
      "get": {
        "operationId": "exportReportDraftMarkdown",
        "security": [{ "BearerAuth": [] }],
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Markdown report draft", "content": { "text/markdown": { "schema": { "type": "string" } } } },
          "404": { "description": "report draft not found" }
        }
      }
    }
  }
