{
  "openapi": "3.1.0",
  "info": {
    "title": "经销商分析助手全域业务 API",
    "version": "4.0.0",
    "description": "提供大模型分析经销商业务的核心API。包含【汇总指标】与【全字段明细】。\n\n**大模型（AI）调度规则（必须遵守）：**\n1. **首选汇总**：遇到分析趋势、达成率、对比、宏观统计时，优先调用 `_metrics` 接口获取已计算好的数据。\n2. **按需抓取明细**：只有用户明确要求查看具体流水记录时，才调用 `_details` 接口。\n3. **分页与归纳法则**：当 `_details` 返回大量数据时，AI必须使用 `page` 和 `pageSize` (默认50) 进行分批抓取。"
  },
  "servers": [
    {
      "url": "http://localhost:8081",
      "description": "本地开发环境"
    },
    {
      "url": "https://your-api-domain.com",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Short-lived opaque access token returned by /api/auth/login or /api/auth/refresh."
      }
    },
    "schemas": {
      "DashboardSummary": {
        "type": "object",
        "description": "Dashboard MVP 聚合数据，默认基于当前 active import batch。",
        "properties": {
          "dataStatus": {
            "type": "object",
            "description": "当前数据源、批次、导入质量和模拟数据提示。"
          },
          "overview": {
            "type": "object",
            "description": "目标达成、商机、线索、任务和活动的顶部 KPI。"
          },
          "targetAchievement": {
            "type": "object",
            "description": "低达成经销商和区域目标达成排行。"
          },
          "opportunityFunnel": {
            "type": "object",
            "description": "商机阶段分布和赢单率。"
          },
          "leadSources": {
            "type": "object",
            "description": "线索来源数量和转化率。"
          },
          "followUpTasks": {
            "type": "object",
            "description": "跟进任务完成率、逾期率和积压门店。"
          },
          "campaignEffect": {
            "type": "object",
            "description": "活动目标与实际产出对比。"
          }
        }
      },
      "TargetMetrics": {
        "type": "object",
        "properties": {
          "totalDealers": {
            "type": "integer"
          },
          "totalAsKTarget": {
            "type": "integer"
          },
          "totalOpportunityWon": {
            "type": "integer"
          },
          "averageAchievementRate": {
            "type": "number"
          },
          "lowestDealer": {
            "$ref": "#/components/schemas/DealerMetric"
          },
          "highestDealer": {
            "$ref": "#/components/schemas/DealerMetric"
          }
        }
      },
      "DealerMetric": {
        "type": "object",
        "properties": {
          "dealerCode": {
            "type": "string"
          },
          "dealerName": {
            "type": "string"
          },
          "achievementRate": {
            "type": "number"
          }
        }
      },
      "TargetDetail": {
        "type": "object",
        "properties": {
          "dealerCode": {
            "type": "string"
          },
          "dealerName": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "dealerGroupName": {
            "type": "string"
          },
          "productModel": {
            "type": "string"
          },
          "targetYear": {
            "type": "integer"
          },
          "targetMonth": {
            "type": "integer"
          },
          "asKTarget": {
            "type": "integer"
          },
          "opportunityWonCount": {
            "type": "integer"
          }
        }
      },
      "OpportunityMetrics": {
        "type": "object",
        "properties": {
          "totalOpportunities": {
            "type": "integer"
          },
          "wonCount": {
            "type": "integer"
          },
          "lostCount": {
            "type": "integer"
          },
          "openCount": {
            "type": "integer"
          },
          "winRate": {
            "type": "number"
          },
          "stageDistribution": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "topLossReasons": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LossReason"
            }
          }
        }
      },
      "LossReason": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      },
      "OpportunityDetail": {
        "type": "object",
        "properties": {
          "opportunityId": {
            "type": "string"
          },
          "dealerCode": {
            "type": "string"
          },
          "dealerName": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "dealerGroupName": {
            "type": "string"
          },
          "productModel": {
            "type": "string"
          },
          "stageName": {
            "type": "string"
          },
          "leadSource": {
            "type": "string"
          },
          "createdDate": {
            "type": "string"
          },
          "probability": {
            "type": "integer"
          }
        }
      },
      "LeadMetrics": {
        "type": "object",
        "properties": {
          "totalLeads": {
            "type": "integer"
          },
          "convertedCount": {
            "type": "integer"
          },
          "conversionRate": {
            "type": "number"
          },
          "sourceDistribution": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "bestConversionSource": {
            "$ref": "#/components/schemas/SourceMetric"
          }
        }
      },
      "SourceMetric": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "conversionRate": {
            "type": "number"
          }
        }
      },
      "LeadDetail": {
        "type": "object",
        "properties": {
          "leadId": {
            "type": "string"
          },
          "dealerCode": {
            "type": "string"
          },
          "dealerName": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "dealerGroupName": {
            "type": "string"
          },
          "leadSource": {
            "type": "string"
          },
          "stageName": {
            "type": "string"
          },
          "productModel": {
            "type": "string"
          },
          "createdDate": {
            "type": "string"
          },
          "isConverted": {
            "type": "boolean"
          }
        }
      },
      "TaskMetrics": {
        "type": "object",
        "properties": {
          "totalTasks": {
            "type": "integer"
          },
          "completedCount": {
            "type": "integer"
          },
          "openCount": {
            "type": "integer"
          },
          "overdueCount": {
            "type": "integer"
          },
          "completionRate": {
            "type": "number"
          },
          "highestBacklogDealer": {
            "$ref": "#/components/schemas/BacklogDealer"
          }
        }
      },
      "BacklogDealer": {
        "type": "object",
        "properties": {
          "dealerCode": {
            "type": "string"
          },
          "dealerName": {
            "type": "string"
          },
          "openCount": {
            "type": "integer"
          },
          "overdueCount": {
            "type": "integer"
          }
        }
      },
      "TaskDetail": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string"
          },
          "dealerCode": {
            "type": "string"
          },
          "dealerName": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "dealerGroupName": {
            "type": "string"
          },
          "opportunityId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "createdDate": {
            "type": "string"
          }
        }
      },
      "CampaignMetrics": {
        "type": "object",
        "properties": {
          "totalCampaigns": {
            "type": "integer"
          },
          "averageAttainment": {
            "type": "number"
          },
          "bestCampaign": {
            "$ref": "#/components/schemas/BestCampaign"
          },
          "totalActualOpportunities": {
            "type": "integer"
          },
          "totalTarget": {
            "type": "integer"
          }
        }
      },
      "BestCampaign": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string"
          },
          "campaignName": {
            "type": "string"
          },
          "attainmentRate": {
            "type": "number"
          }
        }
      },
      "CampaignDetail": {
        "type": "object",
        "properties": {
          "campaignId": {
            "type": "string"
          },
          "dealerCode": {
            "type": "string"
          },
          "dealerName": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "dealerGroupName": {
            "type": "string"
          },
          "productModel": {
            "type": "string"
          },
          "campaignType": {
            "type": "string"
          },
          "createdDate": {
            "type": "string"
          },
          "actualOpportunityCount": {
            "type": "integer"
          },
          "totalNewCustomerTarget": {
            "type": "integer"
          }
        }
      },
      "ReportDraft": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "reportType": { "type": "string", "enum": ["daily", "weekly", "monthly", "topic"] },
          "title": { "type": "string" },
          "language": { "type": "string", "enum": ["zh", "en"] },
          "markdown": { "type": "string" },
          "generatedAt": { "type": "string", "format": "date-time" },
          "importBatchId": { "type": "string" },
          "scope": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["GLOBAL"] },
              "id": { "type": "string" }
            }
          },
          "model": { "type": "string" },
          "promptVersion": { "type": "string" }
        }
      },
      "ReportDraftRequest": {
        "type": "object",
        "required": ["reportType", "language"],
        "properties": {
          "reportType": { "type": "string", "enum": ["daily", "weekly", "monthly", "topic"] },
          "language": { "type": "string", "enum": ["zh", "en"] },
          "scopeType": { "type": "string", "default": "GLOBAL" },
          "scopeId": { "type": "string" },
          "topic": { "type": "string", "maxLength": 500 }
        }
      },
      "ReportDraftResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" },
          "data": { "$ref": "#/components/schemas/ReportDraft" }
        }
      },
      "ReportDraftListResponse": {
        "type": "object",
        "properties": {
          "code": { "type": "integer" },
          "message": { "type": "string" },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ReportDraft" }
          }
        }
      }
    }
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "operationId": "login",
        "summary": "使用用户名和密码登录",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string" },
                  "password": { "type": "string", "format": "password", "writeOnly": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "返回一次性 opaque access token，并通过 HttpOnly Cookie 设置 refresh token" },
          "401": { "description": "通用凭据错误" },
          "429": { "description": "登录尝试过于频繁" }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "summary": "轮换 refresh token 并签发新的 opaque access token",
        "security": [],
        "responses": {
          "200": { "description": "轮换成功；refresh token 仅通过 HttpOnly Cookie 返回" },
          "401": { "description": "refresh token 过期、撤销或发生重放" },
          "403": { "description": "Origin 不在可信前端来源列表" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "operationId": "getCurrentUser",
        "summary": "获取当前用户、角色与权限",
        "responses": {
          "200": { "description": "当前用户身份、mustChangePassword、角色和权限键" },
          "401": { "description": "access token 无效或已撤销" }
        }
      }
    },
    "/api/auth/password": {
      "post": {
        "operationId": "changePassword",
        "summary": "修改当前用户密码并撤销全部会话",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["currentPassword", "newPassword"],
                "properties": {
                  "currentPassword": { "type": "string", "format": "password", "writeOnly": true },
                  "newPassword": { "type": "string", "format": "password", "writeOnly": true }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "密码已修改；客户端必须重新登录" },
          "400": { "description": "新密码不符合策略" },
          "401": { "description": "当前密码错误" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "summary": "撤销当前会话族",
        "description": "使用 HttpOnly refresh Cookie 撤销当前浏览器会话族；也接受有效 Bearer 会话作为无 Cookie 客户端的回退。携带 Cookie 时必须来自可信 Origin。",
        "security": [],
        "responses": {
          "200": { "description": "当前会话族已撤销，或客户端已处于退出状态" },
          "403": { "description": "Cookie 请求的 Origin 不在可信前端来源列表" }
        }
      }
    },
    "/api/auth/logout-all": {
      "post": {
        "operationId": "logoutAll",
        "summary": "撤销当前用户全部会话",
        "responses": { "200": { "description": "全部会话已撤销" } }
      }
    },
    "/api/admin/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "列出用户（USER_READ）",
        "responses": { "200": { "description": "用户列表" }, "403": { "description": "缺少 USER_READ" } }
      },
      "post": {
        "operationId": "createUser",
        "summary": "使用临时密码创建用户（USER_MANAGE）",
        "responses": { "200": { "description": "用户已创建且 mustChangePassword=true" }, "403": { "description": "缺少 USER_MANAGE" } }
      }
    },
    "/api/admin/users/{id}/enabled": {
      "patch": {
        "operationId": "changeUserEnabled",
        "summary": "启用或停用用户并即时撤销停用用户会话",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "账号状态已更新" }, "409": { "description": "不能停用最后一个有效管理员" } }
      }
    },
    "/api/admin/users/{id}/roles": {
      "put": {
        "operationId": "assignUserRoles",
        "summary": "替换用户角色并撤销其全部会话",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "角色已更新" }, "409": { "description": "不能移除最后一个有效管理员的管理能力" } }
      }
    },
    "/api/admin/users/{id}/reset-password": {
      "post": {
        "operationId": "resetUserPassword",
        "summary": "设置临时密码并撤销用户全部会话",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "密码已重置且 mustChangePassword=true" } }
      }
    },
    "/api/admin/roles": {
      "get": {
        "operationId": "listRoles",
        "summary": "列出角色与权限（ROLE_READ）",
        "responses": { "200": { "description": "角色列表" } }
      },
      "post": {
        "operationId": "createRole",
        "summary": "创建自定义角色（ROLE_MANAGE）",
        "responses": { "200": { "description": "自定义角色已创建" } }
      }
    },
    "/api/admin/roles/{id}/permissions": {
      "put": {
        "operationId": "updateRolePermissions",
        "summary": "更新自定义角色权限并撤销受影响会话",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }],
        "responses": { "200": { "description": "权限已更新" }, "400": { "description": "预置角色受保护或权限键无效" } }
      }
    },
    "/api/dashboard": {
      "get": {
        "operationId": "getDashboardSummary",
        "summary": "【Dashboard MVP】经营看板聚合数据",
        "description": "返回当前 active import batch 的经营概览、数据状态、目标达成、商机漏斗、线索来源、跟进任务和活动效果。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/DashboardSummary"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "登录状态过期或缺少 Bearer token"
          }
        }
      }
    },
    "/api/targets/metrics": {
      "get": {
        "operationId": "getTargetMetrics",
        "summary": "【目标达成】指标汇总查询",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "month",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "productModel",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dealerCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Optional city filter. Supports values such as 沈阳 or Beijing.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dealerName",
            "in": "query",
            "description": "Optional dealer name keyword filter, such as 经销商AJ.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dealerGroupName",
            "in": "query",
            "description": "Optional dealer group name keyword filter.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/TargetMetrics"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/targets/details": {
      "get": {
        "operationId": "getTargetDetails",
        "summary": "【目标达成】全字段流水明细",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "month",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "productModel",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dealerCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "description": "Optional city filter. Supports values such as 沈阳 or Beijing.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dealerName",
            "in": "query",
            "description": "Optional dealer name keyword filter, such as 经销商AJ.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dealerGroupName",
            "in": "query",
            "description": "Optional dealer group name keyword filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "name": "sortBy",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "dealerCode"
            }
          },
          {
            "name": "sortOrder",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer"
                    },
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
